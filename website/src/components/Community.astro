---
import { site, docs } from '../config/site';
const paths = [
  { t: 'Leggi la documentazione', d: 'Guide per server owner, API per sviluppatori, riferimento di Permissions ed eventi.', href: docs('/'), cta: 'Apri la wiki' },
  { t: 'Segnala un bug', d: 'Indica la versione di QRM, i passi per riprodurlo e l’effetto osservato.', href: site.links.issues, cta: 'Apri una issue' },
  { t: 'Contribuisci', d: 'Una pull request verso main, un argomento per volta. Il comando ./gradlew build deve passare.', href: site.links.contributing, cta: 'Linee guida' },
  { t: 'Vulnerabilità', d: 'Non aprire una issue pubblica: usa la segnalazione privata di GitHub.', href: site.links.security, cta: 'Politica di sicurezza' },
];
---
<section class="com dark--cut" id="community" aria-labelledby="com-title">
  <div class="wrap">
    <p class="pix eyebrow" data-reveal>Open source</p>
    <h2 id="com-title" data-reveal style="--i:1">Il codice è aperto. Il tuo contributo ha un posto.</h2>
    <p class="com__lead" data-reveal style="--i:2">QRM è distribuito con licenza {site.license}. Codice e identificatori sono in inglese; commenti e messaggi per l’utente in italiano.</p>
    <ul class="paths">
      {paths.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={p.href} rel="noopener">
            <h3>{p.t}</h3>
            <p>{p.d}</p>
            <span class="go">{p.cta} <i aria-hidden="true">→</i></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="final" aria-labelledby="final-title">
  <div class="wrap final__in">
    <svg class="final__cube" viewBox="0 0 120 124" aria-hidden="true">
      <polygon points="60,6 112,36 60,66 8,36" fill="#7be3f5" />
      <polygon points="8,36 60,66 60,118 8,88" fill="#2aa5c0" />
      <polygon points="112,36 60,66 60,118 112,88" fill="#1b7d96" />
      <path d="M60 22l16 9-16 9-16-9z" fill="#06222b" opacity=".85" />
    </svg>
    <h2 id="final-title">Costruisci il tuo mondo sopra fondamenta che tengono.</h2>
    <div class="final__cta">
      <a class="btn" href="#owner">Inizia dal server</a>
      <a class="btn btn--ghost" href={site.links.repo} rel="noopener">Vedi il codice su GitHub</a>
    </div>
  </div>
</section>

<style>
  .com { padding-block: var(--s-9) var(--s-8); background: var(--ink-900); }
  .com h2 { font-size: var(--step-3); max-width: 22ch; margin-bottom: var(--s-4); }
  .com__lead { color: var(--text-muted); font-size: var(--step-1); max-width: 40rem; margin-bottom: var(--s-7); }
  .paths { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .paths a { display: grid; height: 100%; align-content: start; gap: var(--s-3); padding: var(--s-5); background: var(--ink-700); text-decoration: none; border-top: 4px solid var(--slate-500);
    box-shadow: 6px 6px 0 #060a10; transition: transform var(--t-base) var(--ease-out), border-color var(--t-fast), box-shadow var(--t-base) var(--ease-out); }
  .paths a:hover { transform: translate(-3px, -4px); border-color: var(--cyan); box-shadow: 9px 10px 0 #060a10; }
  .paths a:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .paths h3 { font-size: var(--step-1); }
  .paths p { color: var(--text-muted); font-size: var(--step--1); }
  .go { margin-top: auto; padding-top: var(--s-3); color: var(--gold); font-weight: 700; }
  .go i { display: inline-block; font-style: normal; transition: transform var(--t-base) var(--ease-snap); }
  .paths a:hover .go i { transform: translateX(5px); }

  .final { padding-block: var(--s-9); background: linear-gradient(180deg, var(--ink-900), var(--ink-950)); text-align: center; position: relative; overflow: hidden; }
  .final__in { display: grid; justify-items: center; gap: var(--s-6); }
  .final__cube { width: 7.5rem; height: auto; }
  :global(.js-motion) .final__cube { animation: spin-in var(--t-slow) var(--ease-snap) backwards; animation-timeline: view(); animation-range: entry 0% entry 60%; }
  .final h2 { font-size: var(--step-3); max-width: 20ch; }
  .final__cta { display: flex; flex-wrap: wrap; gap: var(--s-4); justify-content: center; }
  @keyframes spin-in { from { opacity: 0; transform: translateY(-20px) rotate(-6deg); } }
</style>
