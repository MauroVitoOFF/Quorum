---
/**
 * Scena isometrica del framework: il Core al centro, i servizi attorno,
 * Bank sospeso come Module separato. SVG puro, nessun renderer: le facce
 * sono poligoni calcolati qui al build, gli emblemi sono bitmap 5×5 proiettate
 * sulla faccia superiore.
 */
import { blocks } from '../data/content';

const W = 56, H = 32, D = 52, OX = 290, OY = 130;
const P = (a: number, b: number, c: number) => [OX + (a - b) * W, OY + (a + b) * H - c * D] as const;
const pts = (list: ReadonlyArray<readonly [number, number]>) => list.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');

const tones = {
  core: { top: '#7be3f5', left: '#2aa5c0', right: '#1b7d96', glyph: '#06222b' },
  framework: { top: '#6d8cab', left: '#3d5977', right: '#2a4159', glyph: '#e9f1f8' },
  gold: { top: '#f8d57e', left: '#cf9d34', right: '#94691a', glyph: '#3d2a05' },
  module: { top: '#8a6dc4', left: '#563f84', right: '#392a5a', glyph: '#f1eaff' },
  floorA: { top: '#1c2a3d', left: '#142031', right: '#0f1926' },
  floorB: { top: '#182536', left: '#121c2b', right: '#0d1622' },
};
const GLYPHS: Record<string, string[]> = {
  person: ['.###.', '.#.#.', '.###.', '#####', '#...#'],
  coin: ['.###.', '#...#', '#.#.#', '#...#', '.###.'],
  tool: ['####.', '####.', '..#..', '..#..', '..#..'],
  flag: ['#....', '###..', '####.', '###..', '#....'],
  key: ['.###.', '#...#', '#####', '##.##', '#####'],
  core: ['.###.', '#...#', '#.#.#', '#..##', '.####'],
  atm: ['#####', '#.#.#', '#####', '#...#', '#####'],
};

function faces(x: number, y: number, z: number) {
  return {
    top: [P(x, y, z + 1), P(x + 1, y, z + 1), P(x + 1, y + 1, z + 1), P(x, y + 1, z + 1)],
    left: [P(x, y + 1, z + 1), P(x + 1, y + 1, z + 1), P(x + 1, y + 1, z), P(x, y + 1, z)],
    right: [P(x + 1, y, z + 1), P(x + 1, y + 1, z + 1), P(x + 1, y + 1, z), P(x + 1, y, z)],
  };
}
/* matrice che porta il quadrato unitario (u,v) sulla faccia superiore del cubo (x,y,z) */
function topMatrix(x: number, y: number, z: number) {
  const [tx, ty] = P(x, y, z + 1);
  return `matrix(${W} ${H} ${-W} ${H} ${tx} ${ty})`;
}

// pavimento 4×4, senza due angoli: il terreno ha un profilo a gradini
const floor: { x: number; y: number }[] = [];
for (let x = 0; x < 5; x++) for (let y = 0; y < 5; y++) {
  if ((x === 0 && y === 4) || (x === 4 && y === 0)) continue;
  floor.push({ x, y });
}

// ordine di disegno dal fondo: il Core poggia su un pilastro, quindi conta dalla sua base
const depth = (b: (typeof blocks)[number]) => b.x + b.y + b.z - (b.kind === 'core' ? 1 : 0);
const sorted = [...blocks].sort((a, b) => depth(a) - depth(b));
const bank = blocks.find((b) => b.id === 'bank')!;
const core = blocks.find((b) => b.id === 'core')!;
const [bx, by] = P(bank.x + 0.5, bank.y + 0.5, bank.z + 0.5);
const [cx, cy] = P(core.x + 0.5, core.y + 0.5, core.z + 0.5);

const toneOf = (id: string, kind: string) => (id === 'economy' ? tones.gold : kind === 'core' ? tones.core : kind === 'module' ? tones.module : tones.framework);
---
<svg class="scene" viewBox="0 0 580 450" role="group" aria-label="Scena isometrica del framework QRM: sette blocchi selezionabili" data-scene>
  <defs>
    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9" /></filter>
  </defs>

  <!-- ombra sotto il terreno -->
  <ellipse cx="290" cy="372" rx="230" ry="38" fill="#000" opacity=".35" filter="url(#soft)" />

  <g class="layer layer--floor" data-depth="2">
    {floor.map(({ x, y }) => {
      const f = faces(x, y, -1); // la superficie del terreno è a z=0
      const t = (x + y) % 2 ? tones.floorA : tones.floorB;
      return (
        <g>
          <polygon points={pts(f.left)} fill={t.left} />
          <polygon points={pts(f.right)} fill={t.right} />
          <polygon points={pts(f.top)} fill={t.top} stroke="#243650" stroke-width="1" />
        </g>
      );
    })}
  </g>

  <!-- collegamento tratteggiato Core ↔ Bank: il Module si appoggia al framework tramite l'API -->
  <line class="link" x1={cx} y1={cy} x2={bx} y2={by} />

  <g class="layer layer--blocks" data-depth="6">
    {sorted.map((b, i) => {
      const f = faces(b.x, b.y, b.z);
      const t = toneOf(b.id, b.kind);
      const rows = GLYPHS[b.glyph];
      return (
        <g class:list={['blk', `blk--${b.kind}`]} style={`--i:${i}`} data-block={b.id} tabindex="0" role="button" aria-pressed="false" aria-label={`${b.label}: mostra i dettagli`}>
          <g class="blk__body">
            {b.kind === 'core' && (() => { const p = faces(b.x, b.y, b.z - 1); return (<g><polygon points={pts(p.left)} fill={t.left} /><polygon points={pts(p.right)} fill={t.right} /></g>); })()}
            <polygon points={pts(f.left)} fill={t.left} />
            <polygon points={pts(f.right)} fill={t.right} />
            <polygon class="blk__top" points={pts(f.top)} fill={t.top} />
            <g transform={topMatrix(b.x, b.y, b.z)} fill={t.glyph} opacity=".92" aria-hidden="true">
              {rows.map((row, r) => [...row].map((ch, c) => ch === '#' ? <rect x={0.18 + c * 0.128} y={0.18 + r * 0.128} width="0.128" height="0.128" /> : null))}
            </g>
            <polyline class="blk__edge" points={pts([...f.top, f.top[0]])} fill="none" />
          </g>
        </g>
      );
    })}
  </g>

  <!-- sole decorativo, in pixel -->
  <g class="sun" aria-hidden="true">
    <path d="M40 30h16v6h6v16h-6v6H40v-6h-6V36h6z" fill="#f5c75b" />
    <path d="M46 20h4v6h-4zM46 66h4v6h-4zM26 40h6v4h-6zM64 40h6v4h-6z" fill="#f8d57e" />
  </g>
</svg>

<style>
  .scene { width: 100%; height: auto; overflow: visible; touch-action: manipulation; }
  .layer { transition: transform var(--t-base) var(--ease-out); will-change: transform; }

  .link { stroke: var(--violet); stroke-width: 2; stroke-dasharray: 3 7; opacity: .0; }
  :global(.scene-ready) .link { opacity: .9; transition: opacity var(--t-slow) 600ms; }

  .blk { cursor: pointer; outline: none; }
  .blk__body { transition: transform var(--t-base) var(--ease-snap); transform-box: fill-box; transform-origin: center; }
  .blk__edge { stroke: rgb(255 255 255 / .25); stroke-width: 1; pointer-events: none; }
  .blk:hover .blk__body, .blk:focus-visible .blk__body { transform: translateY(-9px); }
  .blk:focus-visible .blk__edge { stroke: var(--gold); stroke-width: 3; }
  .blk[aria-pressed='true'] .blk__edge { stroke: var(--gold); stroke-width: 3; }
  .blk[aria-pressed='true'] .blk__body { transform: translateY(-9px); }

  /* il Module Bank fluttua: l'unico movimento continuo della scena */
  .blk--module .blk__body { animation: bob 5s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-7px); } }
  .paused .blk--module .blk__body { animation-play-state: paused; }

  /* ingresso: i blocchi cadono al loro posto, una volta */
  :global(.js-motion) .blk { animation: drop var(--t-slow) var(--ease-snap) backwards; animation-delay: calc(var(--i) * 90ms + 120ms); }
  @keyframes drop { from { opacity: 0; transform: translateY(-46px); } }

  @media (max-width: 480px) { .blk:hover .blk__body { transform: none; } }
</style>
