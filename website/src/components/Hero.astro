---
import Scene from './Scene.astro';
import { site, docs } from '../config/site';
import { blocks } from '../data/content';
import { inline } from '../config/md';
const first = blocks[0];
---
<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="sky" aria-hidden="true"><i class="cloud c1"></i><i class="cloud c2"></i><i class="cloud c3"></i></div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="pix eyebrow" data-reveal>Mod per server roleplay · NeoForge</p>
      <h1 id="hero-title" data-reveal style="--i:1">
        Il giocatore gioca.<br /><span class="mark">Il personaggio vive.</span>
      </h1>
      <p class="lead" data-reveal style="--i:2">
        QRM dà al tuo server personaggi, lavori, organizzazioni, permessi e un’economia.
        Si installa come un mod, si configura con file di testo e si gestisce dalla chat.
      </p>
      <div class="cta" data-reveal style="--i:3">
        <a class="btn" href="#storia">Guarda come funziona</a>
        <a class="btn btn--ghost" href={docs('')}>Apri la wiki</a>
      </div>
      <ul class="facts" data-reveal style="--i:4" aria-label="Versioni e compatibilità">
        <li><span class="pix">Mod</span> v{site.version}</li>
        <li><span class="pix">Minecraft</span> {site.minecraft}</li>
        <li><span class="pix">NeoForge</span> {site.neoforge}+</li>
        <li><span class="pix">Java</span> {site.java}</li>
      </ul>
      <p class="status" data-reveal style="--i:5">QRM è alla versione 0.x: comandi e impostazioni possono cambiare da una versione all’altra.</p>
    </div>

    <div class="hero__visual">
      <div class="scene-box" data-scene-box>
        <Scene />
      </div>
      <div class="caption" aria-live="polite" data-caption>
        <p class="pix" data-cap-kind>Il mod</p>
        <p class="caption__t" data-cap-title>{first.title}</p>
        <p data-cap-text set:html={inline(first.text)} />
        <a data-cap-link href={docs(first.doc)}>Approfondisci nella wiki →</a>
      </div>
      <p class="hint">Seleziona un blocco per vedere cosa fa.</p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(2rem, 6vw, 5rem) var(--s-9); isolation: isolate; }
  .sky { position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background:
      radial-gradient(60rem 36rem at 78% 30%, rgb(62 201 230 / .14), transparent 70%),
      linear-gradient(180deg, var(--ink-900), var(--ink-800) 100%); }
  /* profilo a gradini del terreno in fondo alla hero */
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 56px; z-index: -1;
    background: var(--paper);
    clip-path: polygon(0 100%, 0 70%, 6% 70%, 6% 45%, 14% 45%, 14% 70%, 23% 70%, 23% 30%, 31% 30%, 31% 55%, 44% 55%, 44% 25%, 52% 25%, 52% 60%, 63% 60%, 63% 35%, 71% 35%, 71% 70%, 83% 70%, 83% 40%, 92% 40%, 92% 65%, 100% 65%, 100% 100%); }
  /* nuvole a blocchi: scorrono lentissime, ferme se la hero è fuori vista */
  .cloud { position: absolute; left: -12rem; width: 9rem; height: 1.5rem; background: rgb(255 255 255 / .08);
    box-shadow: 1.5rem -1.5rem 0 0 rgb(255 255 255 / .08), 4.5rem -1.5rem 0 0 rgb(255 255 255 / .08), 3rem 1.5rem 0 -0.25rem rgb(255 255 255 / .05); }
  .c1 { top: 12%; } .c2 { top: 34%; transform: scale(.7); opacity: .8; } .c3 { top: 58%; transform: scale(1.2); opacity: .5; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .cloud { animation: drift 120s linear infinite; }
    :global(.js-motion) .c2 { animation-duration: 160s; animation-delay: -60s; }
    :global(.js-motion) .c3 { animation-duration: 200s; animation-delay: -120s; }
    .paused .cloud { animation-play-state: paused; }
  }
  @keyframes drift { to { translate: calc(100vw + 24rem) 0; } }

  .hero__grid { display: grid; grid-template-columns: 1fr; gap: var(--s-7); align-items: center; }
  h1 { font-size: var(--step-4); letter-spacing: -0.035em; }
  .mark { color: var(--cyan); }
  .lead { margin-top: var(--s-5); font-size: var(--step-1); color: var(--text-muted); max-width: 34rem; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-6); }
  .facts { list-style: none; padding: 0; margin: var(--s-6) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-muted); }
  .facts .pix { display: block; font-size: 0.58rem; color: var(--slate-300); margin-bottom: 2px; }
  .status { margin-top: var(--s-4); font-size: var(--step--1); color: var(--slate-300); max-width: 32rem; }

  .hero__visual { position: relative; }
  .scene-box { max-width: 31rem; margin-inline: auto; }
  .caption { margin: var(--s-3) auto 0; max-width: 33rem; padding: var(--s-5); background: var(--ink-700); border-left: 6px solid var(--cyan); box-shadow: var(--extrude) var(--extrude) 0 #060a10; min-height: 10.5rem; }
  .caption .caption__t { font: 700 var(--step-1)/1.2 var(--font-display); color: var(--text); margin: var(--s-2) 0 var(--s-3); }
  .caption p:not(.pix) { color: var(--text-muted); }
  .caption a { display: inline-block; margin-top: var(--s-3); color: var(--gold); font-weight: 600; }
  .caption[data-kind='module'] { border-left-color: #8a6dc4; }
  .caption[data-kind='core'] { border-left-color: var(--cyan); }
  .caption[data-kind='framework'] { border-left-color: var(--slate-300); }
  .caption.is-swap { animation: swap var(--t-base) var(--ease-out); }
  @keyframes swap { from { opacity: .0; transform: translateY(6px); } }
  .hint { text-align: center; margin-top: var(--s-3); font-size: var(--step--1); color: var(--slate-300); }

  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: var(--s-8); }
    .hero { padding-top: var(--s-8); }
  }
</style>
