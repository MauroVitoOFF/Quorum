---
import { site, docs, asset } from '../config/site';
---
<section class="hero scope-dark" id="top" aria-labelledby="hero-title" data-hero>
  <div class="sky" aria-hidden="true"><i class="cloud c1"></i><i class="cloud c2"></i><i class="cloud c3"></i></div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="pix eyebrow" data-reveal>Framework roleplay · NeoForge</p>
      <h1 id="hero-title" data-reveal style="--i:1">
        Tu crei il mondo,<br /><span class="mark">loro lo vivono.</span>
      </h1>
      <p class="lead" data-reveal style="--i:2">
        Non stiamo solo aggiungendo regole, stiamo cambiando il modo in cui Minecraft viene vissuto. Quorum è
        l’infrastruttura definitiva che separa l’umano dal personaggio. Nasce per darti una tela bianca su cui dipingere la tua
        società ideale: un sistema che pensa a mantenere l’ordine sotto il cofano, per lasciare a te e ai tuoi giocatori solo
        la pura magia del roleplay.
      </p>
      <div class="cta" data-reveal style="--i:3">
        <a class="btn" href="#pilastri">Scopri il progetto</a>
        <a class="btn btn--ghost" href={docs('')}>Apri la wiki</a>
      </div>
      <ul class="facts" data-reveal style="--i:4" aria-label="Versioni e compatibilità">
        <li><span class="pix">Mod</span> v{site.version}</li>
        <li><span class="pix">Minecraft</span> {site.minecraft}</li>
        <li><span class="pix">NeoForge</span> {site.neoforge}+</li>
        <li><span class="pix">Java</span> {site.java}</li>
      </ul>
    </div>

  </div>

  <!-- Illustrazione: di notte, il poliziotto insegue il fuggitivo. Decorativa: il testo accanto dice tutto. -->
  <div class="hero__art" aria-hidden="true">
    <img
      src={asset('art/hero-1920.webp')}
      srcset={`${asset('art/hero-1280.webp')} 1280w, ${asset('art/hero-1920.webp')} 1920w`}
      sizes="(min-width: 1100px) 75vw, 100vw"
      width="1920" height="1072" alt="" decoding="async" fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero { --copy-w: 36rem; position: relative; padding-block: clamp(2rem, 6vw, 5rem) var(--s-9); isolation: isolate; }
  .sky { position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background:
      radial-gradient(60rem 36rem at 78% 30%, rgb(91 141 239 / .16), transparent 70%),
      linear-gradient(180deg, var(--ink-900), var(--ink-800) 100%); }
  /* profilo a gradini del terreno in fondo alla hero */
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 56px; z-index: -1;
    background: var(--paper-page);
    clip-path: polygon(0 100%, 0 70%, 6% 70%, 6% 45%, 14% 45%, 14% 70%, 23% 70%, 23% 30%, 31% 30%, 31% 55%, 44% 55%, 44% 25%, 52% 25%, 52% 60%, 63% 60%, 63% 35%, 71% 35%, 71% 70%, 83% 70%, 83% 40%, 92% 40%, 92% 65%, 100% 65%, 100% 100%); }
  /* nuvole a blocchi: scorrono lentissime, ferme se la hero è fuori vista */
  .cloud { position: absolute; left: -12rem; width: 9rem; height: 1.5rem; background: rgb(255 255 255 / .08);
    box-shadow: 1.5rem -1.5rem 0 0 rgb(255 255 255 / .08), 4.5rem -1.5rem 0 0 rgb(255 255 255 / .08), 3rem 1.5rem 0 -0.25rem rgb(255 255 255 / .05); }
  .c1 { top: 12%; } .c2 { top: 34%; transform: scale(.7); opacity: .8; } .c3 { top: 58%; transform: scale(1.2); opacity: .5; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-motion) .cloud { animation: drift 120s linear infinite; }
    :global(.js-motion) .c2 { animation-duration: 160s; animation-delay: -60s; }
    :global(.js-motion) .c3 { animation-duration: 200s; animation-delay: -120s; }
    .paused .cloud { animation-play-state: paused; }
  }
  @keyframes drift { to { translate: calc(100vw + 24rem) 0; } }

  .hero__grid { display: grid; grid-template-columns: 1fr; gap: var(--s-7); align-items: center; }
  h1 { font-size: var(--step-4); letter-spacing: -0.035em; }
  .mark { color: var(--blue); }
  .lead { margin-top: var(--s-5); font-size: 1.25rem; color: var(--text-muted); max-width: var(--copy-w); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-6); }
  .facts { list-style: none; padding: 0; margin: var(--s-6) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); font-family: var(--font-mono); font-size: var(--step--1); color: var(--text-muted); }
  .facts .pix { display: block; font-size: 0.58rem; color: var(--slate-300); margin-bottom: 2px; }


  /* l'illustrazione: sotto il testo sui telefoni, a destra e sfumata a sinistra dal desktop in su */
  .hero__art { margin-top: var(--s-7);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent); }
  .hero__art img { display: block; width: 100%; height: auto; }

  @media (min-width: 1100px) {
    .hero { --copy-w: min(36rem, 44vw); padding-top: var(--s-8); min-height: min(46rem, 92svh); display: grid; align-items: center; }
    .hero__grid { grid-template-columns: minmax(0, var(--copy-w)) minmax(0, 1fr); }
    .hero__copy { max-width: var(--copy-w); }
    /* inizia dove finisce la colonna del testo, così non passa mai sotto le righe: la sfumatura parte da lì.
       Alta fino a 42rem e centrata in verticale: l'immagine si ingrandisce e, se serve, si taglia ai lati (restando centrata
       sui due personaggi); i bordi sfumano nel fondo della sezione */
    .hero__art { position: absolute; z-index: -1; top: 50%; right: 0; height: min(100%, 42rem); margin: 0; transform: translateY(-50%);
      left: calc(max(var(--gutter), (100% - var(--wrap)) / 2) + var(--copy-w) + var(--s-5));
      -webkit-mask-image: linear-gradient(to right, transparent, #000 12%), linear-gradient(to bottom, transparent, #000 16%, #000 78%, transparent);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to right, transparent, #000 12%), linear-gradient(to bottom, transparent, #000 16%, #000 78%, transparent);
      mask-composite: intersect; }
    .hero__art img { height: 100%; object-fit: cover; object-position: 46% 45%; }
  }
</style>
