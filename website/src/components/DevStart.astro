---
import { quickstart as q } from '../data/content';
import { site, docs } from '../config/site';
import { inline } from '../config/md';

const fill = (s: string) => s.replaceAll('{version}', site.version);
const blocks = [
  { title: 'Compila il mod', code: q.dev.build, note: q.dev.buildNote },
  { title: 'Pubblica l’API in locale', code: q.dev.publish, note: q.dev.publishNote },
  { title: 'build.gradle del tuo Module', code: fill(q.dev.gradle), note: 'Usa `compileOnly`: a runtime le librerie le porta già il jar `qrm`.' },
  { title: 'META-INF/neoforge.mods.toml', code: fill(q.dev.toml), note: 'Dichiara QRM come dipendenza obbligatoria, caricata prima del tuo mod.' },
  { title: 'Il tuo primo handler', code: fill(q.dev.java), note: 'Registra una Currency e scrive nel log ogni Transaction completata. Frammento tratto dalla documentazione: servono gli import e un `LOGGER`.' },
];
---
<section class="dq" id="quickstart" aria-labelledby="dq-title">
  <div class="wrap">
    <p class="pix eyebrow" data-reveal>Quickstart per sviluppatori</p>
    <h2 id="dq-title" data-reveal style="--i:1">Il tuo primo Module, in cinque passi.</h2>
    <p class="dq__lead" data-reveal style="--i:2">
      Non c’è ancora un repository Maven pubblico: l’API si ottiene in locale. Il Module <code>qrm-bank</code> è un progetto completo da cui partire.
    </p>

    <ol class="blocks">
      {blocks.map((b, i) => (
        <li data-reveal style={`--i:${i % 2}`}>
          <p class="cap"><span class="num">{i + 1}</span> {b.title}</p>
          <div class="codebox">
            <pre><code>{b.code}</code></pre>
            <button type="button" class="copy" data-copy={b.code} aria-label={`Copia: ${b.title}`}><span aria-hidden="true">Copia</span></button>
          </div>
          <p class="note" set:html={inline(b.note)} />
        </li>
      ))}
    </ol>

    <p class="more" data-reveal>
      <a class="btn btn--cyan" href={docs('sviluppatori/quickstart')} rel="noopener">Quickstart completo</a>
      <a class="btn btn--ghost" href={docs('sviluppatori/')} rel="noopener">Guida per sviluppatori</a>
    </p>
  </div>
</section>

<style>
  .dq { padding-block: var(--s-9); background: var(--ink-900); }
  .dq h2 { font-size: var(--step-3); max-width: 20ch; margin-bottom: var(--s-4); }
  .dq__lead { font-size: var(--step-1); color: var(--snow); max-width: 44rem; margin-bottom: var(--s-7); }
  .blocks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6); }
  .blocks li { min-width: 0; }
  .cap { display: flex; align-items: center; gap: var(--s-3); font-weight: 700; font-size: var(--step-0); margin-bottom: var(--s-2); }
  .num { display: grid; place-items: center; width: 2rem; height: 2rem; background: var(--ink-950); color: var(--cyan); font: 400 .9rem/1 var(--font-pixel); border-bottom: 3px solid var(--cyan-deep); }
  .codebox { position: relative; background: var(--ink-950); border-left: 4px solid var(--cyan); }
  .codebox pre { margin: 0; padding: var(--s-4) 5rem var(--s-4) var(--s-4); overflow-x: auto; font-size: .88rem; line-height: 1.6; }
  .note { margin-top: var(--s-2); color: var(--snow); font-size: var(--step--1); max-width: 40rem; }
  .copy { position: absolute; top: var(--s-2); right: var(--s-2); font: 700 var(--step--1)/1 var(--font-body); min-height: 2.5rem; min-width: 4.2rem; background: var(--gold); color: var(--ink-950); border: 0; cursor: pointer; box-shadow: 0 3px 0 var(--gold-deep); transition: transform var(--t-fast) var(--ease-out), box-shadow var(--t-fast); }
  .copy:hover { transform: translateY(-1px); } .copy:active { transform: translateY(3px); box-shadow: none; }
  .copy:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .copy.is-done { background: #8ee6a8; box-shadow: 0 3px 0 #3f9a5f; }
  .more { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-7); }
  @media (min-width: 960px) { .blocks { grid-template-columns: 1fr 1fr; gap: var(--s-6) var(--s-7); } .blocks li:last-child { grid-column: 1 / -1; } }
</style>
