---
import { startSteps } from '../data/owner';
import { site, docs, asset } from '../config/site';
import { inline } from '../config/md';

const help = [
  { t: 'Esplora la wiki ufficiale', d: 'Architettura dettagliata di ogni sistema, guida alla compilazione da sorgente, struttura dei file ed elenco completo dei comandi.', href: docs(''), cta: 'Apri la documentazione' },
  { t: 'Codice sorgente e segnalazioni', d: 'Consulta il repository su GitHub, segui l’avanzamento dello sviluppo o apri una segnalazione pubblica nella sezione Issues.', href: site.links.repo, cta: 'Vai al progetto su GitHub' },
];
---
<section class="start paper paper--cut" id="inizia" aria-labelledby="start-title">
  <div class="wrap">
    <p class="pix eyebrow" data-reveal>Per chi crea il server</p>
    <h2 id="start-title" data-reveal style="--i:1">Complesso per i giocatori. Semplice da amministrare.</h2>
    <p class="start__lead" data-reveal style="--i:2">
      Dietro la profondità del roleplay c’è un’architettura pensata per non farti perdere tempo in configurazioni fragili o infrastrutture esterne.
    </p>

    <ol class="steps">
      {startSteps.map((s, i) => (
        <li data-reveal style={`--i:${i}`}>
          <span class="tile" style={`background-image:url(${asset(`pixel/${s.tile}`)})`}><b aria-hidden="true">{i + 1}</b></span>
          <div>
            <h3>{s.title}</h3>
            <p set:html={inline(s.text)} />
            <a href={docs(s.doc)}>{s.link} →</a>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="help__title" data-reveal>Uno sguardo al codice e alla documentazione</h3>
    <p class="note" data-reveal>
      QRM è in sviluppo attivo: attualmente alla versione {site.version}, per Minecraft {site.minecraft}, NeoForge {site.neoforge}+ e Java {site.java}.
      Non è ancora stata pubblicata una release precompilata: i file <code>.jar</code> si ottengono compilando direttamente il codice sorgente,
      con le istruzioni nella wiki. Comandi e impostazioni possono cambiare da una versione all’altra.
    </p>
    <ul class="help">
      {help.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={p.href} rel="noopener">
            <h4>{p.t}</h4>
            <p>{p.d}</p>
            <span class="go">{p.cta} <i aria-hidden="true">→</i></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="final scope-dark" aria-labelledby="final-title">
  <div class="wrap final__in">
    <h2 id="final-title">Pronto a dare vita al tuo server?</h2>
    <div class="final__cta">
      <a class="btn" href={docs('per-iniziare/installazione/')}>Inizia dalla guida di installazione</a>
      <a class="btn btn--ghost" href={docs('')}>Sfoglia la wiki</a>
    </div>
  </div>
  <!-- Illustrazione decorativa: all'alba i due camminano insieme. -->
  <div class="final__art" aria-hidden="true">
    <img
      src={asset('art/closing-1920.webp')}
      srcset={`${asset('art/closing-1280.webp')} 1280w, ${asset('art/closing-1920.webp')} 1920w`}
      sizes="100vw" width="1920" height="1072" alt="" loading="lazy" decoding="async"
    />
  </div>
</section>

<style>
  .start { padding-block: var(--s-9); }
  .start h2 { font-size: var(--step-3); max-width: 18ch; margin-bottom: var(--s-4); }
  .start__lead { font-size: var(--step-1); max-width: 40rem; margin-bottom: var(--s-7); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .steps li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: var(--s-4); align-items: start; padding: var(--s-5); background: var(--ink-800); color: var(--snow); box-shadow: 6px 6px 0 var(--block-shadow); }
  .tile { display: grid; place-items: center; width: 4rem; height: 4rem; background-size: cover; image-rendering: pixelated; box-shadow: inset 0 0 0 3px rgb(0 0 0 / .35), 0 4px 0 var(--block-shadow); }
  .tile b { font: 400 1.6rem/1 var(--font-pixel); color: #fff; text-shadow: 3px 3px 0 #000; }
  .steps h3 { font-size: var(--step-1); margin-bottom: var(--s-2); color: var(--text); }
  .steps p { font-size: var(--step-0); line-height: 1.55; color: var(--snow); }
  /* due classi: deve superare `.paper code:not(pre code)` di base.css, pensata per il fondo chiaro */
  .start .steps code { background: rgb(255 255 255 / .1); }
  .steps a { display: inline-block; margin-top: var(--s-3); color: var(--blue); font-weight: 600; }

  .note { margin: var(--s-4) 0 var(--s-6); padding: var(--s-4) var(--s-5); max-width: 52rem; border-left: 6px solid var(--paper-gold); background: color-mix(in srgb, var(--paper-gold) 8%, transparent); }

  .help__title { font-size: var(--step-2); margin: var(--s-8) 0 var(--s-5); }
  .help { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); max-width: 52rem; }
  .help a { display: grid; height: 100%; align-content: start; gap: var(--s-3); padding: var(--s-5); background: var(--ink-800); text-decoration: none; border-top: 4px solid var(--slate-500);
    box-shadow: 6px 6px 0 var(--block-shadow); transition: transform var(--t-base) var(--ease-out), border-color var(--t-fast); }
  .help a:hover { transform: translate(-3px, -4px); border-color: var(--blue); }
  .help a:focus-visible { outline: 3px solid var(--paper-blue); outline-offset: 3px; }
  .help h4 { font-size: var(--step-1); color: var(--text); }
  .help p { color: var(--snow); font-size: var(--step--1); }
  .go { margin-top: auto; padding-top: var(--s-3); color: var(--blue); font-weight: 700; }
  .go i { display: inline-block; font-style: normal; transition: transform var(--t-base) var(--ease-snap); }
  .help a:hover .go i { transform: translateX(5px); }

  .final { padding-block: var(--s-9) 0; background: linear-gradient(180deg, var(--ink-900), var(--ink-950)); text-align: center; position: relative; overflow: hidden; }
  .final__in { display: grid; justify-items: center; gap: var(--s-6); }
  .final h2 { font-size: var(--step-3); max-width: 20ch; }
  .final__art { margin-top: var(--s-8); }
  .final__art img { display: block; width: 100%; height: auto; max-height: 70svh; object-fit: cover; object-position: 50% 72%; }
  .final__cta { display: flex; flex-wrap: wrap; gap: var(--s-4); justify-content: center; }
</style>
