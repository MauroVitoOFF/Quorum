---
import { pillars } from '../data/owner';
import { docs, asset } from '../config/site';
---
<section class="pillars paper" id="pilastri" aria-labelledby="pillars-title" data-pause>
  <div class="wrap">
    <p class="pix eyebrow" data-reveal>Il progetto</p>
    <h2 id="pillars-title" data-reveal style="--i:1">Quattro pilastri per dare vita al tuo server.</h2>
    <p class="pillars__lead" data-reveal style="--i:2">
      QRM non è una raccolta di comandi slegati, ma una base unica in cui identità, ruoli, denaro e amministrazione parlano la stessa lingua.
    </p>

    <!-- Un solo rettangolo a pagine: ogni pilastro è una pagina, i pallini a destra passano dall'una all'altra.
         Senza JavaScript le pagine restano una sotto l'altra e i pallini non compaiono. -->
    <div class="deck" data-deck data-reveal style="--i:3">
      <div class="deck__pages">
        {pillars.map((p, i) => (
          <article class="page" id={`pillar-${i}`} role="tabpanel" aria-labelledby={`pillar-title-${i}`}>
            <div class="page__icon" aria-hidden="true">
              <span class="drop"><img src={asset(`pixel/${p.icon}`)} width="16" height="16" alt="" loading="lazy" /></span>
              <span class="shadow"></span>
            </div>
            <div class="page__body">
              <p class="pix page__kicker">{p.index}</p>
              <h3 id={`pillar-title-${i}`}>{p.title}</h3>
              <div class="page__cols">
                <p class="line"><span class="pix">In gioco</span>{p.game}</p>
                <p class="line"><span class="pix">Architettura</span>{p.arch}</p>
              </div>
              <a class="page__link" href={docs(p.doc)}>{p.link} →</a>
            </div>
          </article>
        ))}
      </div>

      <div class="deck__dots" role="tablist" aria-label="Pilastri" aria-orientation="vertical">
        {pillars.map((p, i) => (
          <button
            type="button" class="dot" role="tab" id={`pillar-tab-${i}`} aria-controls={`pillar-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
            aria-label={`Pilastro ${i + 1} di ${pillars.length}: ${p.index.split('·')[1]?.trim() ?? p.index}`}
            title={p.index}
          ><span aria-hidden="true"></span></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pillars { padding-block: var(--s-9); }
  .pillars h2 { font-size: var(--step-3); max-width: 18ch; margin-bottom: var(--s-4); }
  .pillars__lead { font-size: var(--step-1); color: var(--paper-muted); max-width: 40rem; margin-bottom: var(--s-7); }

  /* il rettangolo: una fascia a blocchi, come le schede dei Modules */
  .deck { display: grid; grid-template-columns: minmax(0, 1fr); background: var(--ink-700); border-top: 4px solid var(--blue-deep); box-shadow: 6px 6px 0 var(--block-shadow); }

  /* le pagine: senza JS una sotto l'altra, separate da un filo */
  .page { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); padding: var(--s-5) var(--s-4); }
  .page + .page { border-top: 2px dotted var(--paper-edge); }

  /* con JS le pagine stanno nella stessa cella: il rettangolo ha l'altezza della più alta e non salta cambiando pagina */
  .deck.is-paged .deck__pages { display: grid; }
  .deck.is-paged .page { grid-area: 1 / 1; border-top: 0; visibility: hidden; opacity: 0; }
  .deck.is-paged .page.is-current { visibility: visible; opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .deck.is-paged .page { transition: opacity .35s var(--ease-out), visibility 0s linear .35s; }
    .deck.is-paged .page.is-current { transition: opacity .35s var(--ease-out) .05s, visibility 0s; }
  }

  /* l'oggetto "a terra" come in Minecraft: ruota e ondeggia sopra la sua ombra */
  .page__icon { position: relative; width: 3.5rem; height: 3.5rem; display: grid; place-items: center; }
  .drop { display: block; perspective: 300px; animation: item-bob 2.4s ease-in-out infinite; }
  .drop img { width: 2.5rem; height: 2.5rem; image-rendering: pixelated; animation: item-spin 4s linear infinite; filter: drop-shadow(0 0 0 #000); }
  .shadow { position: absolute; bottom: .2rem; left: 50%; width: 2rem; height: .5rem; margin-left: -1rem; background: rgb(0 0 0 / .22); border-radius: 50%; animation: item-shadow 2.4s ease-in-out infinite; }
  @keyframes item-bob { 50% { transform: translateY(-.45rem); } }
  @keyframes item-spin { to { transform: rotateY(360deg); } }
  @keyframes item-shadow { 50% { transform: scale(.78); opacity: .6; } }
  .paused .drop, .paused .drop img, .paused .shadow { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .drop, .drop img, .shadow { animation: none; } }

  /* il testo: gerarchia in tre livelli (indice, titolo, corpo), misura di riga contenuta */
  .page__body { min-width: 0; }
  .page__kicker { margin-bottom: var(--s-3); font-size: .7rem; letter-spacing: .08em; }
  .page h3 { font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.1rem); line-height: 1.15; max-width: 24ch; margin-bottom: var(--s-5); text-wrap: balance; }
  .page__cols { display: grid; gap: var(--s-4); }
  .line { font-size: var(--step-0); line-height: 1.65; color: var(--paper-muted); max-width: 34rem; }
  .line .pix { display: block; margin-bottom: var(--s-1); font-size: .62rem; letter-spacing: .08em; color: var(--paper-gold); }
  .page__link { display: inline-block; margin-top: var(--s-5); color: var(--paper-blue); font-weight: 700; font-size: var(--step-0); }

  /* i pallini: sotto il testo sui telefoni, a destra e centrati in verticale dal tablet in su */
  .deck__dots { display: none; }
  .deck.is-paged .deck__dots { display: flex; justify-content: center; gap: var(--s-1); padding: 0 var(--s-4) var(--s-4); }
  .dot { appearance: none; border: 0; background: none; padding: 0; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; cursor: pointer; }
  .dot span { width: .8rem; height: .8rem; border-radius: 50%; background: transparent; box-shadow: inset 0 0 0 2px var(--slate-500); transition: transform .2s var(--ease-out), background-color .2s, box-shadow .2s; }
  .dot:hover span { box-shadow: inset 0 0 0 2px var(--paper-gold); }
  .dot[aria-selected='true'] span { background: var(--gold); box-shadow: inset 0 0 0 2px var(--gold); transform: scale(1.3); }
  .dot:focus-visible { outline: 2px solid var(--paper-blue); outline-offset: -4px; border-radius: 50%; }
  @media (prefers-reduced-motion: reduce) { .dot span { transition: none; } }

  @media (min-width: 860px) {
    .deck.is-paged { grid-template-columns: minmax(0, 1fr) auto; }
    .page { grid-template-columns: 7rem minmax(0, 1fr); gap: var(--s-6); padding: var(--s-7) var(--s-6); align-items: start; }
    .page__icon { width: 7rem; height: 7rem; }
    .drop img { width: 4.25rem; height: 4.25rem; }
    .page__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
    .deck.is-paged .deck__dots { flex-direction: column; justify-content: center; align-self: stretch; padding: 0 var(--s-4) 0 0; }
  }
</style>
