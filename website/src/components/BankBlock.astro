---
import { docs, asset } from '../config/site';
const facts = [
  'Click destro sul blocco: si apre una schermata con tre schede, Conto, Contanti e Bonifico.',
  'Il contante è fatto di oggetti veri nell’inventario, uno per taglio e per valuta.',
  'I bonifici vanno a «Nome Cognome» o a una Organization, con una causale di massimo 64 caratteri.',
  'Il server decide tutto: personaggio attivo, distanza, permessi, limiti. Se il blocco viene rotto o ci si allontana, la schermata si chiude da sola.',
];
---
<section class="bank" id="banca" aria-labelledby="bank-title" data-pause>
  <div class="wrap bank__grid">
    <div class="bank__copy">
      <p class="pix eyebrow" data-reveal>Modulo Bank · facoltativo</p>
      <h2 id="bank-title" data-reveal style="--i:1">Soldi che si toccano.</h2>
      <ul data-reveal style="--i:2">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
      <p class="bank__more" data-reveal style="--i:3"><a href={docs('modules/bank/')} rel="noopener">Il modulo Bank nella documentazione →</a></p>
    </div>

    <div class="stage" data-reveal style={`--i:2;--grass:url(${asset('pixel/grass_top.png')}); --dirt:url(${asset('pixel/dirt.png')})`} data-bank-stage data-crack={asset('pixel/crack.png')}>
      <p class="badge pix" role="note">Animazione decorativa</p>
      <div class="sky">
        <div class="atmwrap">
          <div class="block" data-block-el aria-hidden="true">
            <img class="block__tex" src={asset('pixel/atm.png')} alt="" width="16" height="16" />
            <span class="block__crack" data-crack-el></span>
          </div>
          <div class="items" data-items aria-hidden="true"></div>
        </div>
      </div>
      <div class="ground">
        <button class="btn" type="button" data-break>Rompi il blocco</button>
        <p class="live" role="status" aria-live="polite" data-break-status>Il blocco ATM è al suo posto.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .bank { padding-block: var(--s-9); background: linear-gradient(180deg, var(--ink-900), #0d1624); }
  .bank__grid { display: grid; gap: var(--s-8); align-items: center; }
  .bank h2 { font-size: var(--step-3); margin-bottom: var(--s-5); }
  .bank ul { margin: 0 0 var(--s-5); padding-left: 1.2rem; display: grid; gap: var(--s-3); font-size: var(--step-0); color: var(--snow); }
  .bank li::marker { color: var(--gold); }
  .bank__more a { color: var(--gold); font-weight: 700; }

  .stage { position: relative; box-shadow: 10px 10px 0 #060a10; overflow: hidden; }
  .badge { position: absolute; top: .6rem; left: .6rem; background: var(--gold); color: var(--ink-950) !important; padding: .2rem .5rem; margin: 0 !important; z-index: 3; }
  .sky { height: 15rem; display: flex; align-items: flex-end; justify-content: center; background: linear-gradient(180deg, #2f5d85, #6fa3c9); }
  .ground { padding: var(--s-5); display: grid; justify-items: center; gap: var(--s-3); text-align: center;
    background: var(--grass) 0 0 / 3.5rem 3.5rem; border-top: 4px solid rgb(0 0 0 / .25); image-rendering: pixelated; box-shadow: inset 0 0 0 100vmax rgb(0 0 0 / .18); }
  .atmwrap { position: relative; width: 9rem; height: 9rem; z-index: 2; }
  .block { position: relative; width: 100%; height: 100%; box-shadow: 0 10px 0 rgb(0 0 0 / .25); transform-origin: 50% 100%; }
  .block__tex { width: 100%; height: 100%; image-rendering: pixelated; display: block; }
  .block__crack { position: absolute; inset: 0; background-size: 1000% 100%; background-position: 0 0; image-rendering: pixelated; opacity: 0; }
  .block.is-shaking { animation: shake .12s linear infinite; }
  .block.is-gone { visibility: hidden; }
  .block.is-back { animation: respawn var(--t-base) var(--ease-snap); }
  @keyframes shake { 25% { transform: translateX(-3px) rotate(-1deg); } 75% { transform: translateX(3px) rotate(1deg); } }
  @keyframes respawn { from { transform: scale(.2); opacity: 0; } }

  .items { position: absolute; inset: 0; pointer-events: none; }
  .it { position: absolute; left: 50%; bottom: 0; width: 3.4rem; height: 3.4rem; margin-left: -1.7rem; will-change: transform; }
  .it img { width: 100%; height: 100%; image-rendering: pixelated; animation: item-spin 3s linear infinite; }
  .it .sh { position: absolute; left: 15%; right: 15%; bottom: -.3rem; height: .4rem; background: rgb(0 0 0 / .3); border-radius: 50%; }
  .paused .it img { animation-play-state: paused; }
  @keyframes item-spin { to { transform: rotateY(360deg); } }
  .px { position: absolute; width: .5rem; height: .5rem; image-rendering: pixelated; will-change: transform; }

  .live { font-size: var(--step--1); color: #fff; background: rgb(0 0 0 / .7); padding: .3rem .7rem; min-height: 1.7em; }
  @media (prefers-reduced-motion: reduce) { .it img { animation: none; } }
  @media (min-width: 960px) { .bank__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-9); } }
</style>
