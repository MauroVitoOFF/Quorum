---
import { slots } from '../data/owner';
import { docs, asset } from '../config/site';
import { inline } from '../config/md';
---
<section class="feat paper paper--cut" id="funzioni" aria-labelledby="feat-title" data-pause>
  <div class="wrap">
    <p class="pix eyebrow" data-reveal>Cosa aggiunge</p>
    <h2 id="feat-title" data-reveal style="--i:1">Cosa aggiunge al tuo server.</h2>
    <p class="feat__lead" data-reveal style="--i:2">Cinque sistemi, già collegati fra loro. Scegline uno dalla barra rapida.</p>

    <div class="hotbar" role="tablist" aria-label="Funzioni di QRM" data-hotbar data-reveal style="--i:3">
      {slots.map((s, i) => (
        <button type="button" role="tab" id={`hb-${s.id}`} aria-controls={`pn-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="slot">
          <span class="slot__n" aria-hidden="true">{i + 1}</span>
          <img src={asset(`pixel/${s.icon}`)} width="16" height="16" alt="" />
          <span class="slot__name" aria-hidden="true">{s.name}</span>
          <span class="sr-only">{s.name}</span>
        </button>
      ))}
    </div>

    <div class="panels" data-panels>
      {slots.map((s) => (
        <article class="panel" role="tabpanel" id={`pn-${s.id}`} aria-labelledby={`hb-${s.id}`} tabindex="0" data-panel>
          <div class="panel__item" aria-hidden="true">
            <span class="drop"><img src={asset(`pixel/${s.icon}`)} width="16" height="16" alt="" /></span>
            <span class="shadow"></span>
          </div>
          <div class="panel__text">
            <p class="pix">{s.kicker}</p>
            <h3>{s.title}</h3>
            <p><strong>Il problema.</strong> {s.problem}</p>
            <p set:html={'<strong>Cosa fa QRM.</strong> ' + inline(s.what)} />
            <p class="you" set:html={'<strong>Per te:</strong> ' + inline(s.owner)} />
            <a href={docs(s.doc)}>{s.link} nella wiki →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feat { padding-block: var(--s-9); }
  .feat h2 { font-size: var(--step-3); max-width: 20ch; margin-bottom: var(--s-4); }
  .feat__lead { color: var(--paper-muted); font-size: var(--step-1); margin-bottom: var(--s-6); }

  /* barra rapida in stile inventario */
  .hotbar { display: inline-flex; gap: 4px; padding: 6px; background: #8b8b8b; border: 4px solid #1b1b1b; box-shadow: inset 4px 4px 0 #c6c6c6, inset -4px -4px 0 #555, 6px 6px 0 rgb(23 32 44 / .35); max-width: 100%; }
  .slot { all: unset; box-sizing: border-box; position: relative; width: clamp(3.4rem, 14vw, 4.75rem); aspect-ratio: 1; display: grid; place-items: center; cursor: pointer;
    background: #8b8b8b; box-shadow: inset 3px 3px 0 #373737, inset -3px -3px 0 #fff; }
  .slot img { width: 62%; height: 62%; image-rendering: pixelated; transition: transform var(--t-base) var(--ease-snap); }
  .slot__n { position: absolute; top: 2px; left: 5px; font: 400 .6rem/1 var(--font-pixel); color: #373737; }
  .slot:hover img { transform: translateY(-4px) scale(1.08); }
  .slot:focus-visible { outline: 3px solid var(--paper-blue); outline-offset: 2px; z-index: 2; }
  .slot[aria-selected='true'] { box-shadow: inset 0 0 0 4px #fff, inset 0 0 0 7px #1b1b1b; z-index: 1; }
  .slot[aria-selected='true'] img { transform: scale(1.15); }
  /* il nome dell'oggetto compare sopra lo slot scelto, come nel gioco */
  .slot__name { position: absolute; bottom: calc(100% + 12px); left: 50%; translate: -50% 0; white-space: nowrap; padding: .25rem .6rem; background: #100010; color: #fff; border: 2px solid #2a0a5a; font-size: .82rem; opacity: 0; pointer-events: none; transition: opacity var(--t-fast); }
  .slot[aria-selected='true'] .slot__name, .slot:hover .slot__name { opacity: 1; }
  .hotbar { margin-top: var(--s-6); }

  .panels { margin-top: var(--s-7); }
  .panel { display: grid; gap: var(--s-6); padding: var(--s-6); background: var(--panel); border: 2px solid var(--paper-edge); box-shadow: 10px 10px 0 var(--block-shadow); margin-bottom: var(--s-6); }
  .panel:focus-visible { outline: 3px solid var(--paper-blue); outline-offset: 4px; }
  .panel h3 { font-size: var(--step-2); margin: var(--s-2) 0 var(--s-4); }
  .panel__text p:not(.pix) { color: var(--paper-muted); margin-bottom: var(--s-3); max-width: 40rem; font-size: var(--step-0); }
  .panel__text strong { color: var(--paper-ink); }
  .you { padding: var(--s-3) var(--s-4); background: color-mix(in srgb, var(--paper-blue) 12%, var(--panel)); border-left: 5px solid var(--paper-blue); }
  .panel a { display: inline-block; margin-top: var(--s-2); color: var(--paper-blue); font-weight: 700; }
  .panel code { background: var(--code-bg); }

  .panel__item { position: relative; width: 8rem; height: 8rem; display: grid; place-items: center; justify-self: center; background: #8b8b8b; box-shadow: inset 4px 4px 0 #373737, inset -4px -4px 0 #fff; }
  .drop { display: block; perspective: 300px; animation: item-bob 2.4s ease-in-out infinite; }
  .drop img { width: 4.5rem; height: 4.5rem; image-rendering: pixelated; animation: item-spin 4s linear infinite; }
  .shadow { position: absolute; bottom: .9rem; left: 50%; width: 3.2rem; height: .7rem; margin-left: -1.6rem; background: rgb(0 0 0 / .3); border-radius: 50%; animation: item-shadow 2.4s ease-in-out infinite; }
  @keyframes item-bob { 50% { transform: translateY(-.55rem); } }
  @keyframes item-spin { to { transform: rotateY(360deg); } }
  @keyframes item-shadow { 50% { transform: scale(.75); opacity: .6; } }
  .paused .drop, .paused .drop img, .paused .shadow { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .drop, .drop img, .shadow { animation: none; } }

  /* con JS le schede mostrano un pannello alla volta; senza JS sono tutti visibili */
  :global(.js-tabs) .panel[hidden] { display: none; }
  :global(.js-tabs) .panel.is-in { animation: panel-in var(--t-base) var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } }

  @media (min-width: 860px) { .panel { grid-template-columns: 11rem minmax(0, 1fr); align-items: center; gap: var(--s-7); padding: var(--s-7); } .panel__item { width: 11rem; height: 11rem; } .drop img { width: 6rem; height: 6rem; } }
  @media (max-width: 480px) { .slot__n { display: none; } }
</style>
