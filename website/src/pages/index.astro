---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Owner from '../components/Owner.astro';
import BankBlock from '../components/BankBlock.astro';
import Features from '../components/Features.astro';
import DevIntro from '../components/DevIntro.astro';
import Architecture from '../components/Architecture.astro';
import EventFlow from '../components/EventFlow.astro';
import DevStart from '../components/DevStart.astro';
import Commands from '../components/Commands.astro';
import Requirements from '../components/Requirements.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Story />
    <Owner />
    <BankBlock />
    <Features />
    <DevIntro />
    <Architecture />
    <EventFlow />
    <DevStart />
    <Commands />
    <Requirements />
    <Community />
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
  <script type="application/json" id="site-data" set:html={JSON.stringify({ repo: site.githubRepo })} />
</Base>
