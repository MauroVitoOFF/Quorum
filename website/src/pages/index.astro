---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Features from '../components/Features.astro';
import EventFlow from '../components/EventFlow.astro';
import Modules from '../components/Modules.astro';
import Start from '../components/Start.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Loader />
  <Header />
  <main id="main">
    <Hero />
    <!-- sezioni chiare e scure si alternano: il bordo a blocchi di ciascuna presume un colore diverso sopra -->
    <Story />
    <EventFlow />
    <Features />
    <Modules />
    <Start />
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
</Base>
